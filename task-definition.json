{
    "family": "task-servico01",
    "containerDefinitions": [
        {
            "name": "servico01",
            "image": "servico01",
            "cpu": 128,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "DB_HOST",
                    "value": "bdservico01.cwvac0a2oepv.us-east-1.rds.amazonaws.com"
                },
                {
                    "name": "DB_USER",
                    "value": "postgres"
                },
                {
                    "name": "DB_PASSWORD",
                    "value": "Mydb123Mydb"
                },
                {
                    "name": "DB_NAME",
                    "value": "postgres"
                },
                {
                    "name": "DB_PORT",
                    "value": "5432"
                }
            ]
        }
    ],
    "requiresCompatibilities": [
        "EC2"
    ],
    "networkMode": "bridge"
}